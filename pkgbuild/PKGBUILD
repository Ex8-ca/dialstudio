# Maintainer: Marc <https://github.com/Ex8-ca>
pkgname=dialstudio
pkgver=0.1.0
pkgrel=1
pkgdesc='Ulanzi D100H dial controller for Omarchy: daemon, CLI and shortcut binding'
arch=('x86_64' 'aarch64')
url='https://github.com/Ex8-ca/dialstudio'
license=('MIT')
depends=('qt6-base' 'bluez' 'bluez-utils' 'wtype' 'libxkbcommon')
makedepends=('gcc' 'make')
optdepends=('playerctl: media keys without synthesising key presses'
            'swayosd: on-screen display for volume and brightness'
            'brightnessctl: brightness actions'
            'libnotify: page and profile toasts'
            'wireplumber: volume actions (wpctl)')
install=dialstudio.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/dialstudio "$pkgdir/usr/bin/dialstudio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/dialstudio.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dialstudio.svg"
  install -Dm644 pkgbuild/dialstudio.desktop "$pkgdir/usr/share/applications/dialstudio.desktop"
  install -Dm644 pkgbuild/dialstudio.service "$pkgdir/usr/lib/systemd/user/dialstudio.service"
}
