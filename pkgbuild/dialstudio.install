post_install() {
  cat <<'MSG'

  Dial Studio is installed. Start the daemon with:

      systemctl --user enable --now dialstudio

  Then check everything with:  dialstudio doctor
  The dial must already be paired (Omarchy menu > Setup > Bluetooth).

MSG
}

post_upgrade() {
  cat <<'MSG'

  Dial Studio was upgraded. Restart the daemon to use the new version:

      systemctl --user restart dialstudio

MSG
}

pre_remove() {
  echo "  If the daemon is running, stop it first:  systemctl --user disable --now dialstudio"
}
